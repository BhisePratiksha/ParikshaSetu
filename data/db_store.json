      "options": [
        "पुणे (Pune)",
        "मुंबई (Mumbai)",
        "नागपूर (Nagpur)",
        "नाशिक (Nashik)"
      ],
      "options_en": [
        "Pune",
        "Mumbai",
        "Nagpur",
        "Nashik"
      ],
      "correct_answer": "मुंबई (Mumbai)",
      "correct_index": 1,
      "explanation": "महाराष्ट्र राज्य गुप्तवार्ता विभाग (SID) चे मुख्य कार्यालय मुंबई येथे आहे. गुन्हे अन्वेषण विभाग (CID) चे मुख्यालय पुणे येथे आहे.",
      "marks": 1.0,
      "negative_marks": 0.0,
      "paper_id": "pb-2025-pune",
