# Flask Configuration Template
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_me_to_a_secure_random_key

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/parikshasetu_db
MONGO_DB_NAME=parikshasetu_db

# External Papers Mock API URL
PAPERS_API_URL=https://your-hosted-domain.com/papers.json

# Admin Account Defaults
ADMIN_EMAIL=admin@parikshasetu.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=System Administrator

# Server Settings
PORT=5000
HOST=127.0.0.1
UPLOAD_FOLDER=app/static/uploads/pdfs
MAX_CONTENT_LENGTH=16777216

# AI & OCR Services (Optional - system falls back to robust local extractor if not configured)
# Google Gemini API key for multimodal PDF & OCR understanding:
GEMINI_API_KEY=
# OpenAI API key (optional alternative):
OPENAI_API_KEY=
# Local Tesseract OCR binary path (optional - e.g., C:\Program Files\Tesseract-OCR\tesseract.exe):
TESSERACT_CMD=
